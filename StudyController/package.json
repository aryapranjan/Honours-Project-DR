{
  "name": "collaborative-dr-study-controller",
  "version": "0.1.0",
  "private": true,
  "description": "Laptop-authoritative server and protocol contracts for the Collaborative DR study.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "check": "npm run typecheck && npm test",
    "verify": "npm run check && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p dashboard/tsconfig.json --noEmit",
    "dev": "concurrently -k -n server,dashboard \"npm:dev:server\" \"npm:dev:dashboard\"",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:dashboard": "vite",
    "build": "npm run build:server && npm run build:dashboard",
    "build:server": "tsc -p tsconfig.build.json",
    "build:dashboard": "vite build",
    "start": "node dist/server/main.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.4",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
